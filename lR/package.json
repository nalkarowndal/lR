{
  "name": "luxuryrental",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/api"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @luxuryrental/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @luxuryrental/mobile",
    "web:mobile": "npm run web --workspace @luxuryrental/mobile",
    "test:mobile": "npm run test:domain --workspace @luxuryrental/mobile",
