{
  "name": "@luxuryrental/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "db:seed:test": "tsx scripts/seed-test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "helmet": "^8.1.0",
    "zod": "^4.6.7",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
