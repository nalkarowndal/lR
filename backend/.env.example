PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/luxuryrental.sqlite
# Optional server-to-server admin key; empty disables the override entirely.
# If required, configure a high-entropy key via deployment secrets, never in Git.
ADMIN_API_KEY=

# ==============================================================================
# Kakao OAuth 2.0 Credentials
# Official Reference: https://developers.kakao.com/docs/ko/kakaologin/prerequisite
# ==============================================================================
# 1. Kakao Developers Console (https://developers.kakao.com) -> 내 애플리케이션 -> 앱 키 -> REST API 키
KAKAO_REST_API_KEY=

# 2. Kakao Developers Console -> 제품 설정 -> 카카오 로그인 -> 보안 -> Client Secret
KAKAO_CLIENT_SECRET=

# 3. Kakao Developers Console -> 제품 설정 -> 카카오 로그인 -> Redirect URI 등록
KAKAO_REDIRECT_URI=http://localhost:4000/api/v1/auth/kakao/callback

# ==============================================================================
# Google OAuth 2.0 Credentials
# Official Reference: https://console.cloud.google.com/apis/credentials
# ==============================================================================
# 1. Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# 2. Google Cloud Console -> Client Secret
GOOGLE_CLIENT_SECRET=

# 3. Authorized Redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
