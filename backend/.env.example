PORT=4000
NODE_ENV=development
# Development: http://localhost:5173 | Production: https://com-web-x8qu.onrender.com
CLIENT_ORIGIN=https://com-web-x8qu.onrender.com,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://com-web-x8qu.onrender.com
DATABASE_PATH=./data/luxuryrental.sqlite
ADMIN_API_KEY=luxury_admin_secret_key_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword2026!

# ==============================================================================
# Kakao OAuth 2.0 Credentials
# Official Reference: https://developers.kakao.com/docs/ko/kakaologin/prerequisite
# ==============================================================================
# 1. Kakao Developers Console (https://developers.kakao.com) -> 내 애플리케이션 -> 앱 키 -> REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# 2. Kakao Developers Console -> 제품 설정 -> 카카오 로그인 -> 보안 -> Client Secret
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# 3. Kakao Developers Console -> 제품 설정 -> 카카오 로그인 -> Redirect URI 등록
# Production: https://com-api-ow0l.onrender.com/api/v1/auth/kakao/callback
# Local: http://localhost:4000/api/v1/auth/kakao/callback
KAKAO_REDIRECT_URI=https://com-api-ow0l.onrender.com/api/v1/auth/kakao/callback

# ==============================================================================
# Google OAuth 2.0 Credentials
# Official Reference: https://console.cloud.google.com/apis/credentials
# ==============================================================================
# 1. Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 2. Google Cloud Console -> Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 3. Authorized Redirect URIs
# Production: https://com-api-ow0l.onrender.com/api/v1/auth/google/callback
# Local: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=https://com-api-ow0l.onrender.com/api/v1/auth/google/callback
